{
    "C_Cpp.default.compilerPath": "D:/msys2/ucrt64/bin/g++.exe",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",

    "files.associations": {
        "iostream": "cpp",
        "limits": "cpp",
        "*.h": "cpp",
        "*.cpp": "cpp"
    },

    "terminal.integrated.profiles.windows": {
        "MSYS2 UCRT64": {
            "path": "D:\\msys2\\usr\\bin\\bash.exe",
            "args": ["--login", "-i"],
            "env": {
                "MSYSTEM": "UCRT64",
                "CHERE_INVOKING": "1"
            }
        }
    },

    "terminal.integrated.env.windows": {
        "PATH": "D:/msys2/ucrt64/bin;${env:PATH}"
    },

    "terminal.integrated.defaultProfile.windows": "MSYS2 UCRT64",

    "cmake.generator": "MinGW Makefiles",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureOnOpen": true,

    "cmake.configureSettings": {
        "CMAKE_MAKE_PROGRAM": "D:/msys2/ucrt64/bin/mingw32-make",
        "CMAKE_C_COMPILER": "D:/msys2/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "D:/msys2/ucrt64/bin/g++.exe"
    }
}
